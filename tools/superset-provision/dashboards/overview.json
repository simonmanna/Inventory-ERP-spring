{
  "module": "overview",
  "title": "Business overview",
  "slug": "erp-overview",
  "filters": [
    { "name": "Period", "type": "time" },
    { "name": "Branch", "dataset": "journal_lines", "column": "branchName" }
  ],
  "charts": [
    { "name": "Revenue", "viz": "kpi_trend", "dataset": "journal_lines", "metric": "SUM(CASE WHEN \"classification\" = 'revenue' THEN \"plAmount\" ELSE 0 END)", "width": 3 },
    { "name": "Net profit", "viz": "kpi_trend", "dataset": "journal_lines", "metric": "SUM(\"plAmount\")", "width": 3 },
    { "name": "Cash received", "viz": "kpi_trend", "dataset": "payments", "metric": "SUM(CASE WHEN \"direction\" = 'inbound' THEN \"amount\" ELSE 0 END)", "width": 3 },
    { "name": "Stock value", "viz": "kpi", "dataset": "stock_on_hand", "metric": "SUM(\"stockValue\")", "subheader": "on hand now", "width": 3, "height": 30 },
    { "name": "Revenue and expenses by month", "viz": "bar_time", "dataset": "journal_lines", "metrics": [{ "sql": "SUM(CASE WHEN \"classification\" = 'revenue' THEN \"plAmount\" ELSE 0 END)", "label": "Revenue" }, { "sql": "SUM(CASE WHEN \"classification\" = 'expense' THEN -\"plAmount\" ELSE 0 END)", "label": "Expenses" }], "width": 8 },
    { "name": "Gross margin", "viz": "gauge", "dataset": "journal_lines", "metric": "100.0 * SUM(CASE WHEN \"reportSection\" IN ('revenue', 'contra_revenue', 'cogs') THEN \"plAmount\" ELSE 0 END) / NULLIF(SUM(CASE WHEN \"reportSection\" IN ('revenue', 'contra_revenue') THEN \"plAmount\" ELSE 0 END), 0)", "max": 100, "format": ",.1f", "description": "(Revenue - cost of goods sold) / revenue, %", "width": 4, "height": 50 },
    { "name": "Net profit by month", "viz": "area", "dataset": "journal_lines", "metric": "SUM(\"plAmount\")", "width": 6 },
    { "name": "Cash in and out by month", "viz": "bar_time", "dataset": "payments", "metrics": [{ "sql": "SUM(CASE WHEN \"direction\" = 'inbound' THEN \"amount\" ELSE 0 END)", "label": "Cash in" }, { "sql": "SUM(CASE WHEN \"direction\" = 'outbound' THEN \"amount\" ELSE 0 END)", "label": "Cash out" }], "width": 6 },
    { "name": "Receivables outstanding", "viz": "kpi", "dataset": "sales_invoices", "metric": "SUM(\"amountResidual\")", "subheader": "customers owe", "width": 3 },
    { "name": "Payables outstanding", "viz": "kpi", "dataset": "vendor_bills", "metric": "SUM(\"amountResidual\")", "subheader": "owed to suppliers", "width": 3 },
    { "name": "Receivables overdue", "viz": "kpi", "dataset": "sales_invoices", "metric": "SUM(CASE WHEN \"daysOverdue\" > 0 THEN \"amountResidual\" ELSE 0 END)", "subheader": "past due date", "width": 3 },
    { "name": "Payables overdue", "viz": "kpi", "dataset": "vendor_bills", "metric": "SUM(CASE WHEN \"daysOverdue\" > 0 THEN \"amountResidual\" ELSE 0 END)", "subheader": "past due date", "width": 3 },
    { "name": "Top customers", "viz": "bar", "dataset": "sales_lines", "x": "customerName", "metric": "SUM(\"signedSubtotal\")", "limit": 8, "width": 4 },
    { "name": "Top products", "viz": "bar", "dataset": "sales_lines", "x": "productName", "metric": "SUM(\"signedSubtotal\")", "limit": 8, "width": 4 },
    { "name": "Where the money goes", "viz": "treemap", "dataset": "journal_lines", "x": ["accountName"], "metric": "SUM(\"baseDebit\" - \"baseCredit\")", "where": "\"classification\" = 'expense'", "limit": 20, "width": 4 }
  ]
}
