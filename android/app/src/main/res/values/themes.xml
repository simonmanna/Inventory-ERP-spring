<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns the real theming; this is just the pre-Compose window
         shell (splash background + no action bar). -->
    <style name="Theme.PosCafe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#1B1B1F</item>
        <item name="android:windowBackground">#FFFBFE</item>
        <!-- Compose already draws its own dark scheme. Without this, MIUI and
             other OEM "dark mode for all apps" settings re-colour the drawn
             UI on top of it (e.g. white text on the light cart bar). -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
