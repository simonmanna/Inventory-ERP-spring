# Inventory-ERP-spring environment. Names match POS-CAFE's .env.example wherever the concept is
# the same, so one .env can drive either backend. Copy to .env and fill in secrets.

# --- Database (JDBC). stringtype=unspecified is REQUIRED (enum columns). ---
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5434/erp?stringtype=unspecified
DB_USER=erp
DB_PASSWORD=erp
DB_POOL_SIZE=20
# Production: connect as a NON-superuser app role so Postgres RLS is enforced (docs/SECURITY.md).

# --- Server ---
PORT=3001
HOST=0.0.0.0
SPRING_PROFILES_ACTIVE=dev
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_LAN=false
LOG_LEVEL=INFO
EXPOSE_ERROR_DETAIL=false
READ_ONLY_MODE=false
# Business time zone for receipts, report days and date filters (Nest: host TZ). JVM/DB stay UTC.
APP_TIMEZONE=UTC
# Bearer token for GET /api/v1/metrics (Prometheus scraper). Required under the prod profile.
METRICS_TOKEN=

# --- Auth (generate each with: openssl rand -base64 48). Startup fails in prod if weak/default. ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_POS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_POS_TTL=12h
MFA_ISSUER=Inventory ERP
# AES key (base64, 32 bytes) for MFA secrets and channel credentials at rest.
APP_ENCRYPTION_KEY=

# --- Seed (profile "seed" only; refuses to run on a non-empty database) ---
SEED_ADMIN_PASSWORD=

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
UPLOAD_MAX_BYTES=10MB
# S3 (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Mail / SMS / Push ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Backups ---
PG_BIN=
BACKUP_DIR=./backups
BACKUP_FULL_RETENTION_DAYS=30
BACKUP_CRON_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_HEALTHCHECKS_PING_URL=
BACKUP_NOTIFY_EMAIL=

# --- Inventory posting ---
STOCK_POSTING_BATCH=50

# --- Optional modules (API). Mirror with VITE_ENABLE_* for the web build. ---
ENABLE_BEVERAGE=false
ENABLE_ASSETS=false
ENABLE_TASKS=false
ENABLE_MANUFACTURING=false
ENABLE_RENTAL=false
ENABLE_REPAIR=false
ENABLE_HR=false
ENABLE_ORDERS=false
ENABLE_COMMUNICATION=false
ENABLE_COMMUNICATION_WHATSAPP=false
ENABLE_COMMUNICATION_TELEGRAM=false
COMM_DISPATCH_POLL_MS=2000
COMM_ENCRYPTION_KEY=
WA_MIN_GAP_MS=1500
WA_DAILY_CAP=1000
TELEGRAM_BOT_TOKEN=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# --- Web (Vite build-time) ---
VITE_API_URL=
VITE_ORG_CODE=DEMO
VITE_DEMO_MODE=
VITE_ENABLE_BEVERAGE=
VITE_ENABLE_TASKS=
VITE_ENABLE_MANUFACTURING=
VITE_ENABLE_HR=
VITE_ENABLE_ORDERS=

# ---------------------------------------------------------------------------
# Licensing — the installation side (ADR-S002, docs/spec/licensing.md)
# ---------------------------------------------------------------------------
# Base URL of the licence authority. Leave empty for an air-gapped shop: it is
# then licensed by an offline .lic file instead, and nothing here is needed.
LICENSE_SERVER_URL=
# Days an install with no licence may run before it becomes read-only.
LICENSE_TRIAL_DAYS=14
# Master switch. false keeps the licence visible and warns, but never refuses a
# write — for development, and for a support session where billing must not be
# what is blocking the diagnosis.
LICENSE_ENFORCE=true
LICENSE_HEARTBEAT=true
LICENSE_HTTP_TIMEOUT=10s
# What this install calls itself in the authority's activation list (default: hostname).
LICENSE_INSTANCE_NAME=

# ---------------------------------------------------------------------------
# Licensing — the authority (OUR infrastructure only, never a customer's)
#   docker compose --profile license up -d --build
# ---------------------------------------------------------------------------
LICENSE_DB_USER=license
LICENSE_DB_PASSWORD=
LICENSE_DB_NAME=license
# Wraps every signing private key at rest. REQUIRED: the service refuses to
# start under the prod profile without it. Losing it means losing the ability
# to sign new licences — back it up somewhere other than this repo.
LICENSE_SIGNING_PASSPHRASE=
# Signs admin sessions. REQUIRED under prod; without it every restart logs
# admins out.
LICENSE_ADMIN_JWT_SECRET=
# Used once, on first boot, to create the first owner account (password must be
# at least 12 characters). Remove both afterwards.
LICENSE_ADMIN_EMAIL=
LICENSE_ADMIN_PASSWORD=
# Renewal reminders.
LICENSE_REMINDERS_ENABLED=true
LICENSE_REMINDER_FROM=
