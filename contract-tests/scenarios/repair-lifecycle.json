{
  "name": "Repair (RMMS) lifecycle on data (ENABLE_REPAIR=true, fresh seed): catalog, order, diagnosis, quotation, jobs, parts, billing, warranty, contracts, reports",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken", "adminId": "$.user.id"}},
    {"name": "warehouse", "method": "GET", "path": "/api/v1/inventory/locations?type=warehouse", "capture": {"loc": "$.data.0.id"}},
    {"name": "service product", "method": "POST", "path": "/api/v1/products", "body": {"code": "RPR-PARITY-SVC", "name": "Parity bench labour", "productType": "service", "salesPrice": 40, "costPrice": 0}, "capture": {"svc": "$.id"}},
    {"name": "part product", "method": "POST", "path": "/api/v1/products", "body": {"code": "RPR-PARITY-PART", "name": "Parity screen", "productType": "stockable", "salesPrice": 120, "costPrice": 50}, "capture": {"part": "$.id"}},
    {"name": "customer", "method": "POST", "path": "/api/v1/partners", "body": {"code": "RPR-PARITY-C", "name": "Parity repair customer", "isCustomer": true}, "capture": {"cust": "$.id"}},
    {"name": "stock in parts", "method": "POST", "path": "/api/v1/inventory/direct-stock/in", "headers": {"Idempotency-Key": "repair-parity-stock-in-1"}, "body": {"locationId": "{{loc}}", "responsibleById": "{{adminId}}", "approvedById": "{{adminId}}", "items": [{"productId": "{{part}}", "quantity": 10, "unitCost": 50}]}},

    {"name": "labour type", "method": "POST", "path": "/api/v1/repair/labour-types", "body": {"code": "LAB-PARITY", "name": "Screen swap", "price": 40, "productId": "{{svc}}"}, "capture": {"lt": "$.id"}},
    {"name": "labour types", "method": "GET", "path": "/api/v1/repair/labour-types?isActive=true"},
    {"name": "labour type update", "method": "PATCH", "path": "/api/v1/repair/labour-types/{{lt}}", "body": {"durationMinutes": 45}},
    {"name": "labour type 404", "method": "PATCH", "path": "/api/v1/repair/labour-types/00000000-0000-0000-0000-000000000000", "body": {}},
    {"name": "technician", "method": "POST", "path": "/api/v1/repair/technicians", "body": {"name": "Parity Tech", "skills": ["phones"], "hourlyRate": 15}, "capture": {"tech": "$.id"}},
    {"name": "technician update", "method": "PATCH", "path": "/api/v1/repair/technicians/{{tech}}", "body": {"availability": "busy"}},
    {"name": "technicians", "method": "GET", "path": "/api/v1/repair/technicians?availability=busy"},

    {"name": "order", "method": "POST", "path": "/api/v1/repair/orders", "body": {"partnerId": "{{cust}}", "itemType": "Phone", "brand": "Acme", "model": "X1", "serialNumber": "PARITY-SN-1", "accessories": ["case"], "problemDescription": "Cracked screen", "items": [{"itemType": "Charger"}]}, "capture": {"ro": "$.id"}},
    {"name": "orders search", "method": "GET", "path": "/api/v1/repair/orders?search=parity-sn"},
    {"name": "add item", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/items", "body": {"itemType": "Case"}, "capture": {"item": "$.id"}},
    {"name": "remove item", "method": "DELETE", "path": "/api/v1/repair/orders/items/{{item}}"},
    {"name": "attachment", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/attachments", "body": {"url": "https://example.test/receipt.png", "caption": "intake"}, "capture": {"att": "$.id"}},
    {"name": "remove attachment", "method": "DELETE", "path": "/api/v1/repair/orders/attachments/{{att}}"},
    {"name": "note: empty", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/notes", "body": {"note": " "}},
    {"name": "note", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/notes", "body": {"note": "Customer called"}},
    {"name": "assign technician", "method": "PATCH", "path": "/api/v1/repair/orders/{{ro}}/technician", "body": {"technicianId": "{{tech}}"}},
    {"name": "transition: no status", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {}},
    {"name": "transition: diagnosis", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "diagnosis"}},
    {"name": "diagnosis", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/diagnosis", "body": {"symptoms": "No touch", "faults": ["digitizer"], "estimatedCost": 160}, "capture": {"diag": "$.id"}},
    {"name": "diagnosis update", "method": "PATCH", "path": "/api/v1/repair/diagnosis/{{diag}}", "body": {"rootCause": "Drop"}},

    {"name": "quotation: bad qty", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/quotations", "body": {"lines": [{"kind": "labour", "quantity": 0}]}},
    {"name": "quotation", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/quotations", "body": {"lines": [{"kind": "labour", "labourTypeId": "{{lt}}", "quantity": 1}, {"kind": "part", "productId": "{{part}}", "quantity": 1}]}, "capture": {"q": "$.id"}},
    {"name": "quotation get", "method": "GET", "path": "/api/v1/repair/quotations/{{q}}"},
    {"name": "quotation submit", "method": "POST", "path": "/api/v1/repair/quotations/{{q}}/submit"},
    {"name": "transition: waiting approval", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "waiting_approval"}},
    {"name": "quotation approve", "method": "POST", "path": "/api/v1/repair/quotations/{{q}}/approve", "body": {}},
    {"name": "quotation approve again", "method": "POST", "path": "/api/v1/repair/quotations/{{q}}/approve", "body": {}},
    {"name": "quotation delete approved", "method": "DELETE", "path": "/api/v1/repair/quotations/{{q}}"},
    {"name": "quotation revise", "method": "POST", "path": "/api/v1/repair/quotations/{{q}}/revise", "body": {"notes": "v2"}, "capture": {"q2": "$.id"}},
    {"name": "quotation reject revision", "method": "POST", "path": "/api/v1/repair/quotations/{{q2}}/reject", "body": {"reason": "keep v1"}},
    {"name": "quotations", "method": "GET", "path": "/api/v1/repair/quotations?repairOrderId={{ro}}"},

    {"name": "job", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/jobs", "body": {"technicianId": "{{tech}}", "instructions": "Swap screen", "checklist": [{"label": "Open", "completed": false}]}, "capture": {"job": "$.id"}},
    {"name": "jobs", "method": "GET", "path": "/api/v1/repair/jobs?repairOrderId={{ro}}"},
    {"name": "job checklist", "method": "POST", "path": "/api/v1/repair/jobs/{{job}}/checklist", "body": {"label": "Seal", "completed": false}},
    {"name": "job start", "method": "POST", "path": "/api/v1/repair/jobs/{{job}}/start"},
    {"name": "job test", "method": "POST", "path": "/api/v1/repair/jobs/{{job}}/test"},
    {"name": "job complete", "method": "POST", "path": "/api/v1/repair/jobs/{{job}}/complete", "body": {"actualHours": 1.5}},
    {"name": "job start after complete", "method": "POST", "path": "/api/v1/repair/jobs/{{job}}/start"},
    {"name": "job update", "method": "PATCH", "path": "/api/v1/repair/jobs/{{job}}", "body": {"notes": "done"}},
    {"name": "job get", "method": "GET", "path": "/api/v1/repair/jobs/{{job}}"},

    {"name": "part reserve: bad qty", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/parts", "body": {"productId": "{{part}}", "quantity": 0}},
    {"name": "part reserve", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/parts", "body": {"productId": "{{part}}", "quantity": 1, "jobId": "{{job}}"}, "capture": {"rp": "$.id"}},
    {"name": "part issue: no location", "method": "POST", "path": "/api/v1/repair/parts/{{rp}}/issue", "body": {}},
    {"name": "part issue", "method": "POST", "path": "/api/v1/repair/parts/{{rp}}/issue", "body": {"locationId": "{{loc}}"}},
    {"name": "part issue again", "method": "POST", "path": "/api/v1/repair/parts/{{rp}}/issue", "body": {"locationId": "{{loc}}"}},
    {"name": "part delete issued", "method": "DELETE", "path": "/api/v1/repair/parts/{{rp}}"},
    {"name": "parts", "method": "GET", "path": "/api/v1/repair/parts?repairOrderId={{ro}}"},

    {"name": "bill: bad line", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/bill", "body": {"lines": [{"kind": "labour", "description": "Unknown labour"}]}},
    {"name": "bill", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/bill", "body": {"paymentMode": "credit"}, "capture": {"inv": "$.invoiceId"}},
    {"name": "bill again", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/bill", "body": {}},
    {"name": "pay invoice", "method": "POST", "path": "/api/v1/repair/invoices/{{inv}}/pay", "body": {"tenders": [{"method": "bank_transfer", "amount": 160, "reference": "PARITY-TRX-1"}]}},
    {"name": "order detail", "method": "GET", "path": "/api/v1/repair/orders/{{ro}}"},
    {"name": "walk to closed: approved→repairing", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "repairing"}},
    {"name": "walk: testing", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "testing"}},
    {"name": "walk: ready", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "ready_pickup"}},
    {"name": "walk: delivered", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "delivered"}},
    {"name": "walk: closed", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "closed", "note": "Picked up"}},
    {"name": "transition from terminal", "method": "POST", "path": "/api/v1/repair/orders/{{ro}}/transition", "body": {"status": "cancelled"}},

    {"name": "warranty", "method": "POST", "path": "/api/v1/repair/warranties", "body": {"repairOrderId": "{{ro}}", "warrantyPeriodMonths": 3, "coverageStart": "2026-01-31T00:00:00.000Z"}, "capture": {"w": "$.id"}},
    {"name": "claim", "method": "POST", "path": "/api/v1/repair/warranties/{{w}}/claims", "body": {"description": "Dead pixels", "amount": 20}, "capture": {"claim": "$.id"}},
    {"name": "claim: bad status", "method": "PATCH", "path": "/api/v1/repair/claims/{{claim}}", "body": {"status": "maybe"}},
    {"name": "claim: reject", "method": "PATCH", "path": "/api/v1/repair/claims/{{claim}}", "body": {"status": "rejected", "resolution": "Wear"}},
    {"name": "warranty expire", "method": "PATCH", "path": "/api/v1/repair/warranties/{{w}}", "body": {"status": "expired"}},
    {"name": "claim on expired", "method": "POST", "path": "/api/v1/repair/warranties/{{w}}/claims", "body": {}},
    {"name": "warranties", "method": "GET", "path": "/api/v1/repair/warranties?repairOrderId={{ro}}"},

    {"name": "contract", "method": "POST", "path": "/api/v1/repair/contracts", "body": {"title": "Parity AC service", "partnerId": "{{cust}}", "frequencyDays": 90}, "capture": {"ctr": "$.id"}},
    {"name": "contract update", "method": "PATCH", "path": "/api/v1/repair/contracts/{{ctr}}", "body": {"slaHours": 8}},
    {"name": "contract activate", "method": "POST", "path": "/api/v1/repair/contracts/{{ctr}}/activate"},
    {"name": "schedule", "method": "POST", "path": "/api/v1/repair/schedules", "body": {"title": "Parity filter clean", "contractId": "{{ctr}}", "intervalDays": 90, "nextDueAt": "2030-01-01T00:00:00.000Z"}, "capture": {"sch": "$.id"}},
    {"name": "schedule update", "method": "PATCH", "path": "/api/v1/repair/schedules/{{sch}}", "body": {"assetRef": "AC-1"}},
    {"name": "schedules", "method": "GET", "path": "/api/v1/repair/schedules?contractId={{ctr}}"},
    {"name": "contracts", "method": "GET", "path": "/api/v1/repair/contracts?partnerId={{cust}}"},
    {"name": "schedule delete", "method": "DELETE", "path": "/api/v1/repair/schedules/{{sch}}"},
    {"name": "contract cancel", "method": "POST", "path": "/api/v1/repair/contracts/{{ctr}}/cancel", "body": {"reason": "Moved"}},
    {"name": "contract delete", "method": "DELETE", "path": "/api/v1/repair/contracts/{{ctr}}"},

    {"name": "dashboard", "method": "GET", "path": "/api/v1/repair/dashboard"},
    {"name": "report operational", "method": "GET", "path": "/api/v1/repair/reports/operational?from=2020-01-01"},
    {"name": "report revenue", "method": "GET", "path": "/api/v1/repair/reports/revenue?from=2020-01-01"},
    {"name": "report technician load", "method": "GET", "path": "/api/v1/repair/reports/technician-load"},
    {"name": "report warranty health", "method": "GET", "path": "/api/v1/repair/reports/warranty-health"},
    {"name": "report contracts", "method": "GET", "path": "/api/v1/repair/reports/contracts"},
    {"name": "technician delete", "method": "DELETE", "path": "/api/v1/repair/technicians/{{tech}}"},
    {"name": "labour type delete", "method": "DELETE", "path": "/api/v1/repair/labour-types/{{lt}}"},
    {"name": "order 404", "method": "GET", "path": "/api/v1/repair/orders/00000000-0000-0000-0000-000000000000"}
  ]
}
