{
  "name": "Kernel: settings, approvals, notifications, reports access, misc",
  "vars": { "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123" },
  "steps": [
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": { "organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}" }, "capture": { "token": "$.accessToken" } },
    { "name": "settings list", "method": "GET", "path": "/api/v1/settings" },
    { "name": "settings features", "method": "GET", "path": "/api/v1/settings/features" },
    { "name": "settings developer", "method": "GET", "path": "/api/v1/settings/developer" },
    { "name": "settings company", "method": "GET", "path": "/api/v1/settings/company" },
    { "name": "settings effective inventory", "method": "GET", "path": "/api/v1/settings/effective?group=inventory" },
    { "name": "settings effective accounting", "method": "GET", "path": "/api/v1/settings/effective?group=accounting" },
    { "name": "inventory defaults", "method": "GET", "path": "/api/v1/settings/inventory-defaults" },
    { "name": "set enum: invalid", "method": "PUT", "path": "/api/v1/settings/inventory.atpMode", "body": { "value": "nope" } },
    { "name": "set enum: unavailable", "method": "PUT", "path": "/api/v1/settings/inventory.stockPostingTiming", "body": { "value": "at_fulfillment_start" } },
    { "name": "set enum", "method": "PUT", "path": "/api/v1/settings/inventory.atpMode", "body": { "value": "strict" } },
    { "name": "set scoped without id", "method": "PUT", "path": "/api/v1/settings/inventory.atpMode", "body": { "value": "strict", "scopeType": "product" } },
    { "name": "unset", "method": "DELETE", "path": "/api/v1/settings/inventory.atpMode" },
    { "name": "approvals pending", "method": "GET", "path": "/api/v1/approvals?status=pending" },
    { "name": "workflow: no steps", "method": "POST", "path": "/api/v1/approval-workflows", "body": { "name": "W", "entityType": "parity_doc", "steps": [] } },
    { "name": "workflow: duplicate order", "method": "POST", "path": "/api/v1/approval-workflows", "body": { "name": "W", "entityType": "parity_doc", "steps": [ { "stepOrder": 1, "name": "A", "approverPermissions": ["approvals:decide"], "requiredCount": 1 }, { "stepOrder": 1, "name": "B", "approverPermissions": ["approvals:decide"], "requiredCount": 1 } ] } },
    { "name": "approval: request without workflow", "method": "POST", "path": "/api/v1/approvals/request", "body": { "entityType": "no_workflow_type", "entityId": "x", "snapshot": { "amount": 5 } } },
    { "name": "approval: not found", "method": "POST", "path": "/api/v1/approvals/00000000-0000-0000-0000-000000000000/decide", "body": { "status": "approved" } },
    { "name": "policy: not found", "method": "GET", "path": "/api/v1/approval-policies/00000000-0000-0000-0000-000000000000" },
    { "name": "notifications", "method": "GET", "path": "/api/v1/notifications?filter=unread" },
    { "name": "notification prefs", "method": "GET", "path": "/api/v1/notifications/preferences" },
    { "name": "reports me", "method": "GET", "path": "/api/v1/reports/access/me" },
    { "name": "reports catalog", "method": "GET", "path": "/api/v1/reports/access/catalog" },
    { "name": "reports roles", "method": "GET", "path": "/api/v1/reports/access/roles" },
    { "name": "search short", "method": "GET", "path": "/api/v1/search?q=a" },
    { "name": "search acme", "method": "GET", "path": "/api/v1/search?q=acme" },
    { "name": "feature flags", "method": "GET", "path": "/api/v1/feature-flags" },
    { "name": "modules", "method": "GET", "path": "/api/v1/feature-flags/modules" },
    { "name": "recurring", "method": "GET", "path": "/api/v1/recurring" },
    { "name": "webhooks", "method": "GET", "path": "/api/v1/webhooks/endpoints" },
    { "name": "files", "method": "GET", "path": "/api/v1/files?ownerType=none&ownerId=none" },
    { "name": "sessions", "method": "GET", "path": "/api/v1/auth/sessions" },
    { "name": "revoke unknown session", "method": "DELETE", "path": "/api/v1/auth/sessions/00000000-0000-0000-0000-000000000000" },
    { "name": "mfa disable not enrolled", "method": "POST", "path": "/api/v1/auth/mfa/disable", "body": { "code": "123456" } },
    { "name": "forgot password", "method": "POST", "path": "/api/v1/auth/forgot-password", "body": { "email": "nobody@demo.test", "organizationCode": "DEMO" } }
  ]
}
