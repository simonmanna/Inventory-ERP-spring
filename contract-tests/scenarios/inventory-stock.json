{
  "name": "Inventory: locations, items, ledger, documents, counts, reservations, reports",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "locations", "method": "GET", "path": "/api/v1/inventory/locations", "capture": {"loc": "$.0.id"}},
    {"name": "location: missing code", "method": "POST", "path": "/api/v1/inventory/locations", "body": {"name": "X"}},
    {"name": "items", "method": "GET", "path": "/api/v1/inventory/items?pageSize=5"},
    {"name": "items: unknown query field", "method": "GET", "path": "/api/v1/inventory/items?foo=1"},
    {"name": "ledger", "method": "GET", "path": "/api/v1/inventory/ledger?pageSize=5"},
    {"name": "stock-out: empty lines", "method": "POST", "path": "/api/v1/inventory/stock-outs", "body": {"locationId": "{{loc}}", "lines": []}},
    {"name": "adjustment: empty lines", "method": "POST", "path": "/api/v1/inventory/adjustments", "body": {"locationId": "{{loc}}", "lines": []}},
    {"name": "transfers", "method": "GET", "path": "/api/v1/inventory/transfers"},
    {"name": "waste summary", "method": "GET", "path": "/api/v1/inventory/waste/summary"},
    {"name": "counts", "method": "GET", "path": "/api/v1/inventory/counts"},
    {"name": "reservations", "method": "GET", "path": "/api/v1/inventory/reservations"},
    {"name": "posting rules", "method": "GET", "path": "/api/v1/inventory/posting-rules"},
    {"name": "stats", "method": "GET", "path": "/api/v1/inventory/stats"},
    {"name": "valuation report", "method": "GET", "path": "/api/v1/inventory/reports/valuation"}
  ]
}
