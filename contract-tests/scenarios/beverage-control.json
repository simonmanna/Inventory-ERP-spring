{
  "name": "Beverage (ENABLE_BEVERAGE=true on both sides): counts list, validation, 404s, reports",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "counts", "method": "GET", "path": "/api/v1/beverage/counts"},
    {"name": "count: not found", "method": "GET", "path": "/api/v1/beverage/counts/00000000-0000-0000-0000-000000000000"},
    {"name": "start: bad countType", "method": "POST", "path": "/api/v1/beverage/counts/start", "body": {"countType": "cycle"}},
    {"name": "start: unknown location", "method": "POST", "path": "/api/v1/beverage/counts/start", "body": {"locationId": "00000000-0000-0000-0000-000000000000"}},
    {"name": "draft: not found", "method": "PATCH", "path": "/api/v1/beverage/counts/00000000-0000-0000-0000-000000000000/draft", "body": {"lines": []}},
    {"name": "draft: lines missing", "method": "PATCH", "path": "/api/v1/beverage/counts/00000000-0000-0000-0000-000000000000/draft", "body": {}},
    {"name": "submit: not found", "method": "POST", "path": "/api/v1/beverage/counts/00000000-0000-0000-0000-000000000000/submit", "body": {}},
    {"name": "cancel: not found", "method": "POST", "path": "/api/v1/beverage/counts/00000000-0000-0000-0000-000000000000/cancel"},
    {"name": "variance", "method": "GET", "path": "/api/v1/beverage/reports/variance"},
    {"name": "yield", "method": "GET", "path": "/api/v1/beverage/reports/yield?from=2024-01-01&to=2024-02-01"},
    {"name": "bartender", "method": "GET", "path": "/api/v1/beverage/reports/bartender?from=2024-01-01&to=2024-02-01"}
  ]
}
