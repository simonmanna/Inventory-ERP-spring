{
  "name": "Manufacturing (ENABLE_MANUFACTURING=true on both sides): lists, validation, 404s, reports, guards",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "boms", "method": "GET", "path": "/api/v1/manufacturing/boms"},
    {"name": "boms: bad body", "method": "POST", "path": "/api/v1/manufacturing/boms", "body": {"name": "", "outputQuantity": -1, "lines": []}},
    {"name": "boms: unknown field", "method": "POST", "path": "/api/v1/manufacturing/boms", "body": {"name": "x", "outputProductId": "p", "outputQuantity": 1, "overheadCostX": 1, "lines": [{"componentProductId": "c", "quantity": 1}]}},
    {"name": "bom: not found", "method": "GET", "path": "/api/v1/manufacturing/boms/00000000-0000-0000-0000-000000000000"},
    {"name": "bom activate: not found", "method": "POST", "path": "/api/v1/manufacturing/boms/00000000-0000-0000-0000-000000000000/activate"},
    {"name": "orders", "method": "GET", "path": "/api/v1/manufacturing/production-orders"},
    {"name": "order: neither bom nor product", "method": "POST", "path": "/api/v1/manufacturing/production-orders", "body": {}},
    {"name": "order: no active bom", "method": "POST", "path": "/api/v1/manufacturing/production-orders", "body": {"outputProductId": "00000000-0000-0000-0000-000000000000", "runs": 1}},
    {"name": "order: ad hoc without plannedQty", "method": "POST", "path": "/api/v1/manufacturing/production-orders", "body": {"outputProductId": "x", "materials": [{"productId": "y", "quantity": 1}]}},
    {"name": "order: not found", "method": "GET", "path": "/api/v1/manufacturing/production-orders/00000000-0000-0000-0000-000000000000"},
    {"name": "order complete: bad body", "method": "POST", "path": "/api/v1/manufacturing/production-orders/00000000-0000-0000-0000-000000000000/complete", "body": {"qtyProduced": 0}},
    {"name": "order start: not found", "method": "POST", "path": "/api/v1/manufacturing/production-orders/00000000-0000-0000-0000-000000000000/start", "body": {}},
    {"name": "menu item: product not found", "method": "POST", "path": "/api/v1/manufacturing/production-orders/finished-goods/00000000-0000-0000-0000-000000000000/menu-item"},
    {"name": "requests", "method": "GET", "path": "/api/v1/manufacturing/requests"},
    {"name": "request: empty lines", "method": "POST", "path": "/api/v1/manufacturing/requests", "body": {"lines": []}},
    {"name": "request submit: not found", "method": "POST", "path": "/api/v1/manufacturing/requests/00000000-0000-0000-0000-000000000000/submit"},
    {"name": "plans", "method": "GET", "path": "/api/v1/manufacturing/plans"},
    {"name": "plan: not found", "method": "GET", "path": "/api/v1/manufacturing/plans/00000000-0000-0000-0000-000000000000"},
    {"name": "mrp from document: not found", "method": "POST", "path": "/api/v1/manufacturing/mrp/from-document/00000000-0000-0000-0000-000000000000"},
    {"name": "wip reconciliation", "method": "GET", "path": "/api/v1/manufacturing/reports/wip-reconciliation"},
    {"name": "kpis", "method": "GET", "path": "/api/v1/manufacturing/reports/kpis?from=2024-01-01&to=2024-02-01"},
    {"name": "trends", "method": "GET", "path": "/api/v1/manufacturing/reports/trends?from=2024-01-01&to=2024-02-01"},
    {"name": "yield by bom", "method": "GET", "path": "/api/v1/manufacturing/reports/yield-by-bom?from=2024-01-01&to=2024-02-01"},
    {"name": "ingredient usage", "method": "GET", "path": "/api/v1/manufacturing/reports/ingredient-usage?from=2024-01-01&to=2024-02-01"},
    {"name": "capacity", "method": "GET", "path": "/api/v1/manufacturing/reports/capacity"},
    {"name": "forecast", "method": "GET", "path": "/api/v1/manufacturing/reports/forecast?weeks=4&targetDate=2024-01-03"},
    {"name": "genealogy forward", "method": "GET", "path": "/api/v1/manufacturing/reports/genealogy/forward/00000000-0000-0000-0000-000000000000"},
    {"name": "work centers", "method": "GET", "path": "/api/v1/manufacturing/work-centers"},
    {"name": "work center: bad body", "method": "POST", "path": "/api/v1/manufacturing/work-centers", "body": {"code": ""}},
    {"name": "resources: bad kind", "method": "POST", "path": "/api/v1/manufacturing/resources", "body": {"name": "x", "kind": "robot"}},
    {"name": "routing: not found", "method": "GET", "path": "/api/v1/manufacturing/routings/00000000-0000-0000-0000-000000000000"},
    {"name": "work order start: not found", "method": "POST", "path": "/api/v1/manufacturing/work-orders/00000000-0000-0000-0000-000000000000/start"},
    {"name": "generate work orders: order not found", "method": "POST", "path": "/api/v1/manufacturing/production-orders/00000000-0000-0000-0000-000000000000/work-orders/generate"}
  ]
}
