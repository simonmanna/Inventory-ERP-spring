{
  "name": "Procurement: landed cost on a posted goods receipt (value allocation, AVCO re-costing, GL), cancel and guards",
  "vars": {
    "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123",
    "k1": "6d2e1c7f-8b52-4b1f-8e1c-0000000000b1", "k2": "6d2e1c7f-8b52-4b1f-8e1c-0000000000b2",
    "k3": "6d2e1c7f-8b52-4b1f-8e1c-0000000000b3", "k4": "6d2e1c7f-8b52-4b1f-8e1c-0000000000b4",
    "k5": "6d2e1c7f-8b52-4b1f-8e1c-0000000000b5"
  },
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "supplier lookup", "method": "GET", "path": "/api/v1/partners?pageSize=1", "capture": {"supplier": "$.data.0.id"}},
    {"name": "product lookup", "method": "GET", "path": "/api/v1/products?productType=stockable&pageSize=1", "capture": {"product": "$.data.0.id"}},
    {"name": "warehouse lookup", "method": "GET", "path": "/api/v1/inventory/locations?type=warehouse", "capture": {"wh": "$.data.0.id"}},
    {"name": "AP account lookup", "method": "GET", "path": "/api/v1/accounts?search=2100&pageSize=1", "capture": {"ap": "$.data.0.id"}},

    {"name": "ad-hoc receipt", "method": "POST", "path": "/api/v1/procurement/goods-receipts/adhoc", "headers": {"Idempotency-Key": "{{k1}}"}, "body": {"partnerId": "{{supplier}}", "warehouseId": "{{wh}}", "lines": [{"productId": "{{product}}", "description": "Beans", "quantity": 10, "unitCost": 100}]}, "capture": {"grn": "$.id"}},
    {"name": "draft receipt", "method": "POST", "path": "/api/v1/procurement/goods-receipts", "body": {"warehouseId": "{{wh}}", "lines": [{"productId": "{{product}}", "description": "Beans", "quantity": 1, "unitCost": 1}]}, "capture": {"draftGrn": "$.id"}},
    {"name": "LC: on a draft receipt", "method": "POST", "path": "/api/v1/procurement/landed-costs", "headers": {"Idempotency-Key": "{{k2}}"}, "body": {"goodsReceiptId": "{{draftGrn}}", "creditAccountId": "{{ap}}", "charges": [{"kind": "freight", "amount": 1}]}},
    {"name": "LC: bad charge kind", "method": "POST", "path": "/api/v1/procurement/landed-costs", "body": {"goodsReceiptId": "{{grn}}", "creditAccountId": "{{ap}}", "charges": [{"kind": "tip", "amount": 1}]}},
    {"name": "LC: unknown credit account", "method": "POST", "path": "/api/v1/procurement/landed-costs", "body": {"goodsReceiptId": "{{grn}}", "creditAccountId": "00000000-0000-0000-0000-000000000000", "charges": [{"kind": "freight", "amount": 1}]}},
    {"name": "LC: create", "method": "POST", "path": "/api/v1/procurement/landed-costs", "headers": {"Idempotency-Key": "{{k3}}"}, "body": {"goodsReceiptId": "{{grn}}", "creditAccountId": "{{ap}}", "charges": [{"kind": "freight", "amount": 150}, {"kind": "duty", "amount": 50}]}, "capture": {"lc": "$.id"}},
    {"name": "LC: post", "method": "POST", "path": "/api/v1/procurement/landed-costs/{{lc}}/post", "headers": {"Idempotency-Key": "{{k4}}"}},
    {"name": "LC: post again", "method": "POST", "path": "/api/v1/procurement/landed-costs/{{lc}}/post"},
    {"name": "LC: cancel posted", "method": "POST", "path": "/api/v1/procurement/landed-costs/{{lc}}/cancel"},
    {"name": "LC: detail", "method": "GET", "path": "/api/v1/procurement/landed-costs/{{lc}}"},
    {"name": "LC: list for receipt", "method": "GET", "path": "/api/v1/procurement/landed-costs?goodsReceiptId={{grn}}"},
    {"name": "LC: unknown", "method": "GET", "path": "/api/v1/procurement/landed-costs/00000000-0000-0000-0000-000000000000"},
    {"name": "GRN: reverse with posted landed cost", "method": "PATCH", "path": "/api/v1/procurement/goods-receipts/{{grn}}/reverse", "headers": {"Idempotency-Key": "{{k5}}"}, "body": {"reason": "wrong supplier"}}
  ]
}
