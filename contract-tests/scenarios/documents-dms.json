{
  "name": "DMS: registry, list, Express route shadowing, action / template validation",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "types", "method": "GET", "path": "/api/v1/documents/types"},
    {"name": "type: sales_invoice", "method": "GET", "path": "/api/v1/documents/types/sales_invoice"},
    {"name": "type: unknown", "method": "GET", "path": "/api/v1/documents/types/nope"},
    {"name": "types/categories (shadowed by :code)", "method": "GET", "path": "/api/v1/documents/types/categories"},
    {"name": "lifecycles", "method": "GET", "path": "/api/v1/documents/lifecycles"},
    {"name": "lifecycle: sales_doc", "method": "GET", "path": "/api/v1/documents/lifecycles/sales_doc"},
    {"name": "documents", "method": "GET", "path": "/api/v1/documents?pageSize=5"},
    {"name": "documents: unknown type", "method": "GET", "path": "/api/v1/documents?type=nope"},
    {"name": "templates (shadowed by :id)", "method": "GET", "path": "/api/v1/documents/templates"},
    {"name": "template: missing fields", "method": "POST", "path": "/api/v1/documents/templates", "body": {}},
    {"name": "action: missing key", "method": "POST", "path": "/api/v1/documents/00000000-0000-0000-0000-000000000000/actions/post", "body": {}},
    {"name": "system type delete", "method": "DELETE", "path": "/api/v1/documents/types/sales_invoice"}
  ]
}
