{
  "name": "CRM: deals, activities, analytics",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken"}},
    {"name": "deals", "method": "GET", "path": "/api/v1/crm/deals?pageSize=5"},
    {"name": "deal: unknown partner", "method": "POST", "path": "/api/v1/crm/deals", "body": {"name": "X", "partnerId": "00000000-0000-0000-0000-000000000000"}},
    {"name": "deal: bad stage", "method": "POST", "path": "/api/v1/crm/deals", "body": {"name": "X", "partnerId": "x", "stage": "nope"}},
    {"name": "deal: not found", "method": "GET", "path": "/api/v1/crm/deals/00000000-0000-0000-0000-000000000000"},
    {"name": "archived deals", "method": "GET", "path": "/api/v1/crm/deals/deleted"},
    {"name": "activities", "method": "GET", "path": "/api/v1/crm/activities"},
    {"name": "activity: bad type", "method": "POST", "path": "/api/v1/crm/activities", "body": {"type": "fax", "title": "x"}},
    {"name": "upcoming", "method": "GET", "path": "/api/v1/crm/activities/upcoming?limit=5"},
    {"name": "pipeline", "method": "GET", "path": "/api/v1/crm/analytics/pipeline"},
    {"name": "win rate", "method": "GET", "path": "/api/v1/crm/analytics/win-rate"},
    {"name": "top customers", "method": "GET", "path": "/api/v1/crm/analytics/top-customers?limit=3"}
  ]
}
