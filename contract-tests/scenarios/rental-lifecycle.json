{
  "name": "Rental lifecycle on data (ENABLE_RENTAL=true, fresh seed): catalog, units, availability, reservations, agreement, checkout, deposits, extension, swap, return, inspection, settlement, service orders, scores, reports. Expected diffs are listed in docs/spec/rental.md (Parity).",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken", "adminId": "$.user.id"}},
    {"name": "fee product RENT-FEE", "method": "POST", "path": "/api/v1/products", "body": {"code": "RENT-FEE", "name": "Rental fee", "productType": "service", "salesPrice": 0, "costPrice": 0}},
    {"name": "fee product RENT-EXTEND", "method": "POST", "path": "/api/v1/products", "body": {"code": "RENT-EXTEND", "name": "Rental extension fee", "productType": "service", "salesPrice": 0, "costPrice": 0}},
    {"name": "fee product RENT-LATE", "method": "POST", "path": "/api/v1/products", "body": {"code": "RENT-LATE", "name": "Rental late fee", "productType": "service", "salesPrice": 0, "costPrice": 0}},
    {"name": "fee product RENT-DAMAGE", "method": "POST", "path": "/api/v1/products", "body": {"code": "RENT-DAMAGE", "name": "Rental damage recovery", "productType": "service", "salesPrice": 0, "costPrice": 0}},
    {"name": "rentable product", "method": "POST", "path": "/api/v1/products", "body": {"code": "RNT-PARITY-CAM", "name": "Parity camera", "productType": "stockable", "salesPrice": 100, "costPrice": 40}, "capture": {"cam": "$.id"}},
    {"name": "accessory product", "method": "POST", "path": "/api/v1/products", "body": {"code": "RNT-PARITY-LENS", "name": "Parity lens", "productType": "stockable", "salesPrice": 30, "costPrice": 10}, "capture": {"lens": "$.id"}},
    {"name": "customer", "method": "POST", "path": "/api/v1/partners", "body": {"code": "RNT-PARITY-C", "name": "Parity renter", "isCustomer": true}, "capture": {"cust": "$.id"}},
    {"name": "setting: late fee per day", "method": "PUT", "path": "/api/v1/settings/rental.lateFeePerDay", "body": {"value": 10}},
    {"name": "setting: deposit policy", "method": "PUT", "path": "/api/v1/settings/rental.depositPolicy", "body": {"value": {"mode": "percent", "percent": 20}}},

    {"name": "locations bootstrap", "method": "POST", "path": "/api/v1/rental/locations/bootstrap", "capture": {"stockLoc": "$.stock"}},
    {"name": "locations bootstrap again", "method": "POST", "path": "/api/v1/rental/locations/bootstrap"},
    {"name": "stock in RENT-STOCK", "method": "POST", "path": "/api/v1/inventory/direct-stock/in", "headers": {"Idempotency-Key": "rental-parity-stock-in-1"}, "body": {"locationId": "{{stockLoc}}", "responsibleById": "{{adminId}}", "approvedById": "{{adminId}}", "items": [{"productId": "{{cam}}", "quantity": 10, "unitCost": 40}]}},

    {"name": "rate: 1-2 days", "method": "POST", "path": "/api/v1/rental/rates", "body": {"productId": "{{cam}}", "period": "day", "minUnits": 1, "maxUnits": 2, "price": 50}, "capture": {"rate1": "$.id"}},
    {"name": "rate: 3+ days", "method": "POST", "path": "/api/v1/rental/rates", "body": {"productId": "{{cam}}", "period": "day", "minUnits": 3, "price": 40}, "capture": {"rate3": "$.id"}},
    {"name": "rate: upsert same band", "method": "POST", "path": "/api/v1/rental/rates", "body": {"productId": "{{cam}}", "period": "day", "minUnits": 1, "maxUnits": 2, "price": 45}},
    {"name": "rate: price 0", "method": "POST", "path": "/api/v1/rental/rates", "body": {"productId": "{{cam}}", "period": "day", "minUnits": 1, "price": 0}},
    {"name": "rate: unknown product", "method": "POST", "path": "/api/v1/rental/rates", "body": {"productId": "00000000-0000-0000-0000-000000000000", "period": "day", "minUnits": 1, "price": 5}},
    {"name": "rate: update priority", "method": "PATCH", "path": "/api/v1/rental/rates/{{rate1}}", "body": {"priority": 5}},
    {"name": "rate: update unknown", "method": "PATCH", "path": "/api/v1/rental/rates/00000000-0000-0000-0000-000000000000", "body": {}},
    {"name": "rate: delete 3+", "method": "DELETE", "path": "/api/v1/rental/rates/{{rate3}}"},
    {"name": "rate: delete again", "method": "DELETE", "path": "/api/v1/rental/rates/{{rate3}}"},
    {"name": "package", "method": "POST", "path": "/api/v1/rental/packages", "body": {"code": "RNT-PARITY-KIT", "name": "Parity kit", "productId": "{{cam}}", "items": [{"productId": "{{lens}}", "quantity": 2}]}, "capture": {"pkg": "$.id"}},
    {"name": "package: unknown product", "method": "POST", "path": "/api/v1/rental/packages", "body": {"code": "RNT-PARITY-BAD", "name": "Bad", "productId": "00000000-0000-0000-0000-000000000000", "items": []}},
    {"name": "package: update", "method": "PATCH", "path": "/api/v1/rental/packages/{{pkg}}", "body": {"name": "Parity kit 2", "items": [{"productId": "{{lens}}", "role": "consumable"}]}},
    {"name": "catalog", "method": "GET", "path": "/api/v1/rental/catalog?productId={{cam}}"},
    {"name": "package: delete", "method": "DELETE", "path": "/api/v1/rental/packages/{{pkg}}"},
    {"name": "package: update deleted", "method": "PATCH", "path": "/api/v1/rental/packages/{{pkg}}", "body": {"name": "x"}},
    {"name": "catalog: include inactive", "method": "GET", "path": "/api/v1/rental/catalog?includeInactive=true"},

    {"name": "units: generate", "method": "POST", "path": "/api/v1/rental/units/generate", "body": {"productId": "{{cam}}", "count": 3, "codeTemplate": "RNT-PARITY-CAM-{n}", "barcodePrefix": "RPC"}, "capture": {"u1": "$.units.0.id", "u2": "$.units.1.id", "u3": "$.units.2.id"}},
    {"name": "units: generate continues numbering", "method": "POST", "path": "/api/v1/rental/units/generate", "body": {"productId": "{{cam}}", "count": 1, "codeTemplate": "RNT-PARITY-CAM-{n}"}, "capture": {"u4": "$.units.0.id"}},
    {"name": "units: count 0", "method": "POST", "path": "/api/v1/rental/units/generate", "body": {"productId": "{{cam}}", "count": 0, "codeTemplate": "X-{n}"}},
    {"name": "units: template without {n}", "method": "POST", "path": "/api/v1/rental/units/generate", "body": {"productId": "{{cam}}", "count": 1, "codeTemplate": "X"}},
    {"name": "units: list", "method": "GET", "path": "/api/v1/rental/units?productId={{cam}}"},
    {"name": "units: search", "method": "GET", "path": "/api/v1/rental/units?search=parity-cam-002"},
    {"name": "units: page 2 (pageSize → Nest 500, documented)", "method": "GET", "path": "/api/v1/rental/units?productId={{cam}}&page=2&pageSize=2"},
    {"name": "units: update", "method": "PATCH", "path": "/api/v1/rental/units/{{u3}}", "body": {"notes": "spare battery", "conditionGrade": "excellent"}},
    {"name": "units: update unknown", "method": "PATCH", "path": "/api/v1/rental/units/00000000-0000-0000-0000-000000000000", "body": {}},
    {"name": "units: retire", "method": "POST", "path": "/api/v1/rental/units/{{u4}}/retire", "body": {"notes": "worn"}},
    {"name": "units: retire again", "method": "POST", "path": "/api/v1/rental/units/{{u4}}/retire"},

    {"name": "availability: missing params", "method": "GET", "path": "/api/v1/rental/availability?productId={{cam}}"},
    {"name": "availability: units missing params", "method": "GET", "path": "/api/v1/rental/availability/units"},
    {"name": "availability", "method": "GET", "path": "/api/v1/rental/availability?productId={{cam}}&startAt=2030-07-01T00:00:00.000Z&endAt=2030-07-03T00:00:00.000Z"},
    {"name": "availability: units", "method": "GET", "path": "/api/v1/rental/availability/units?productId={{cam}}&startAt=2030-07-01T00:00:00.000Z&endAt=2030-07-03T00:00:00.000Z"},
    {"name": "reservation", "method": "POST", "path": "/api/v1/rental/reservations", "body": {"partnerId": "{{cust}}", "startAt": "2030-07-01T00:00:00.000Z", "endAt": "2030-07-03T00:00:00.000Z", "notes": "parity hold", "lines": [{"productId": "{{cam}}", "quantity": 1}]}, "capture": {"rsv": "$.id"}},
    {"name": "reservation: too many", "method": "POST", "path": "/api/v1/rental/reservations", "body": {"partnerId": "{{cust}}", "startAt": "2030-07-01T00:00:00.000Z", "endAt": "2030-07-03T00:00:00.000Z", "lines": [{"productId": "{{cam}}", "quantity": 5}]}},
    {"name": "reservation: bad window", "method": "POST", "path": "/api/v1/rental/reservations", "body": {"partnerId": "{{cust}}", "startAt": "2030-07-03T00:00:00.000Z", "endAt": "2030-07-01T00:00:00.000Z", "lines": [{"productId": "{{cam}}"}]}},
    {"name": "availability after hold", "method": "GET", "path": "/api/v1/rental/availability?productId={{cam}}&startAt=2030-07-01T00:00:00.000Z&endAt=2030-07-03T00:00:00.000Z"},
    {"name": "reservations", "method": "GET", "path": "/api/v1/rental/reservations?partnerId={{cust}}"},
    {"name": "reservation: confirm", "method": "POST", "path": "/api/v1/rental/reservations/{{rsv}}/confirm"},
    {"name": "reservation: cancel", "method": "POST", "path": "/api/v1/rental/reservations/{{rsv}}/cancel"},
    {"name": "reservation: cancel again", "method": "POST", "path": "/api/v1/rental/reservations/{{rsv}}/cancel"},
    {"name": "reservation: unknown", "method": "POST", "path": "/api/v1/rental/reservations/00000000-0000-0000-0000-000000000000/confirm"},

    {"name": "agreement: bad window", "method": "POST", "path": "/api/v1/rental/agreements", "body": {"partnerId": "{{cust}}", "startAt": "2030-06-04T00:00:00.000Z", "dueAt": "2030-06-01T00:00:00.000Z", "lines": [{"productId": "{{cam}}"}]}},
    {"name": "agreement: no lines", "method": "POST", "path": "/api/v1/rental/agreements", "body": {"partnerId": "{{cust}}", "startAt": "2030-06-01T00:00:00.000Z", "dueAt": "2030-06-04T00:00:00.000Z", "lines": []}},
    {"name": "agreement: unknown partner", "method": "POST", "path": "/api/v1/rental/agreements", "body": {"partnerId": "00000000-0000-0000-0000-000000000000", "startAt": "2030-06-01T00:00:00.000Z", "dueAt": "2030-06-04T00:00:00.000Z", "lines": [{"productId": "{{cam}}"}]}},
    {"name": "agreement", "method": "POST", "path": "/api/v1/rental/agreements", "body": {"partnerId": "{{cust}}", "startAt": "2030-06-01T00:00:00.000Z", "dueAt": "2030-06-03T00:00:00.000Z", "notes": "parity", "lines": [{"productId": "{{cam}}", "unitId": "{{u1}}", "ratePeriod": "day", "rateUnits": 2}]}, "capture": {"ag": "$.id", "line": "$.lines.0.id"}},
    {"name": "agreement to cancel", "method": "POST", "path": "/api/v1/rental/agreements", "body": {"partnerId": "{{cust}}", "startAt": "2030-08-01T00:00:00.000Z", "dueAt": "2030-08-02T00:00:00.000Z", "lines": [{"productId": "{{cam}}", "unitRate": 30}]}, "capture": {"ag2": "$.id"}},
    {"name": "agreement: cancel", "method": "POST", "path": "/api/v1/rental/agreements/{{ag2}}/cancel"},
    {"name": "agreement: cancel again", "method": "POST", "path": "/api/v1/rental/agreements/{{ag2}}/cancel"},
    {"name": "agreements", "method": "GET", "path": "/api/v1/rental/agreements?partnerId={{cust}}"},
    {"name": "agreement detail", "method": "GET", "path": "/api/v1/rental/agreements/{{ag}}"},
    {"name": "agreement unknown", "method": "GET", "path": "/api/v1/rental/agreements/00000000-0000-0000-0000-000000000000"},
    {"name": "checkout: draft", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/checkout", "headers": {"Idempotency-Key": "rental-parity-checkout-draft"}, "body": {}},
    {"name": "return: draft", "method": "POST", "path": "/api/v1/rental/returns", "body": {"agreementId": "{{ag}}", "items": [{"agreementLineId": "{{line}}"}]}},
    {"name": "agreement: confirm", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/confirm"},
    {"name": "agreement: confirm again", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/confirm"},
    {"name": "score: hold", "method": "PATCH", "path": "/api/v1/rental/scores/{{cust}}/hold", "body": {"manualHold": true}},
    {"name": "checkout: held partner", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/checkout", "headers": {"Idempotency-Key": "rental-parity-checkout-held"}, "body": {}},
    {"name": "score: release", "method": "PATCH", "path": "/api/v1/rental/scores/{{cust}}/hold", "body": {"manualHold": false}},
    {"name": "checkout", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/checkout", "headers": {"Idempotency-Key": "rental-parity-checkout-1"}, "body": {"depositMethod": "card"}},
    {"name": "deposit", "method": "GET", "path": "/api/v1/rental/agreements/{{ag}}/deposit"},
    {"name": "deposit: unknown agreement", "method": "GET", "path": "/api/v1/rental/agreements/00000000-0000-0000-0000-000000000000/deposit"},
    {"name": "deposit: collect", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/collect", "headers": {"Idempotency-Key": "rental-parity-collect-1"}, "body": {"method": "cash", "amount": 10, "note": "top-up"}},
    {"name": "deposit: collect 0", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/collect", "headers": {"Idempotency-Key": "rental-parity-collect-0"}, "body": {"method": "cash", "amount": 0}},
    {"name": "deposit: refund", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/refund", "headers": {"Idempotency-Key": "rental-parity-refund-1"}, "body": {"method": "cash", "amount": 5}},
    {"name": "deposit: refund too much", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/refund", "headers": {"Idempotency-Key": "rental-parity-refund-2"}, "body": {"method": "cash", "amount": 1000}},
    {"name": "deposit: forfeit", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/forfeit", "headers": {"Idempotency-Key": "rental-parity-forfeit-1"}, "body": {"amount": 2, "note": "late pickup"}},
    {"name": "deposit: forfeit too much", "method": "POST", "path": "/api/v1/rental/agreements/{{ag}}/deposit/forfeit", "headers": {"Idempotency-Key": "rental-parity-forfeit-2"}, "body": {"amount": 1000}},

    {"name": "extension: before due", "method": "POST", "path": "/api/v1/rental/extensions", "headers": {"Idempotency-Key": "rental-parity-ext-0"}, "body": {"agreementId": "{{ag}}", "lineId": "{{line}}", "newDueAt": "2030-06-02T00:00:00.000Z"}},
    {"name": "extension: wrong agreement", "method": "POST", "path": "/api/v1/rental/extensions", "headers": {"Idempotency-Key": "rental-parity-ext-x"}, "body": {"agreementId": "{{ag2}}", "lineId": "{{line}}", "newDueAt": "2030-06-05T00:00:00.000Z"}},
    {"name": "extension", "method": "POST", "path": "/api/v1/rental/extensions", "headers": {"Idempotency-Key": "rental-parity-ext-1"}, "body": {"agreementId": "{{ag}}", "lineId": "{{line}}", "newDueAt": "2030-06-04T00:00:00.000Z"}},
    {"name": "extensions", "method": "GET", "path": "/api/v1/rental/extensions?agreementId={{ag}}"},
    {"name": "swap: same unit", "method": "POST", "path": "/api/v1/rental/swaps", "headers": {"Idempotency-Key": "rental-parity-swap-0"}, "body": {"agreementId": "{{ag}}", "lineId": "{{line}}", "toUnitId": "{{u1}}"}},
    {"name": "swap: retired unit", "method": "POST", "path": "/api/v1/rental/swaps", "headers": {"Idempotency-Key": "rental-parity-swap-r"}, "body": {"agreementId": "{{ag}}", "lineId": "{{line}}", "toUnitId": "{{u4}}"}},
    {"name": "swap", "method": "POST", "path": "/api/v1/rental/swaps", "headers": {"Idempotency-Key": "rental-parity-swap-1"}, "body": {"agreementId": "{{ag}}", "lineId": "{{line}}", "toUnitId": "{{u2}}", "reason": "flicker", "priceDelta": 10}},
    {"name": "swaps", "method": "GET", "path": "/api/v1/rental/swaps?agreementId={{ag}}"},
    {"name": "units after swap", "method": "GET", "path": "/api/v1/rental/units?productId={{cam}}"},

    {"name": "return: no items", "method": "POST", "path": "/api/v1/rental/returns", "body": {"agreementId": "{{ag}}", "items": []}},
    {"name": "return: unknown line", "method": "POST", "path": "/api/v1/rental/returns", "body": {"agreementId": "{{ag}}", "items": [{"agreementLineId": "00000000-0000-0000-0000-000000000000"}]}},
    {"name": "return", "method": "POST", "path": "/api/v1/rental/returns", "body": {"agreementId": "{{ag}}", "notes": "counter", "items": [{"agreementLineId": "{{line}}", "quantity": 1}]}, "capture": {"ret": "$.id"}},
    {"name": "return detail", "method": "GET", "path": "/api/v1/rental/returns/{{ret}}", "capture": {"retLine": "$.lines.0.id"}},
    {"name": "returns", "method": "GET", "path": "/api/v1/rental/returns?agreementId={{ag}}"},
    {"name": "inspect: unknown line", "method": "POST", "path": "/api/v1/rental/returns/{{ret}}/inspect", "body": {"items": [{"returnLineId": "00000000-0000-0000-0000-000000000000"}]}},
    {"name": "inspect", "method": "POST", "path": "/api/v1/rental/returns/{{ret}}/inspect", "body": {"items": [{"returnLineId": "{{retLine}}", "conditionGrade": "poor", "damages": [{"damageType": "scratch", "description": "lens", "chargeAmount": 30}]}]}},
    {"name": "return after inspection", "method": "GET", "path": "/api/v1/rental/returns/{{ret}}", "capture": {"dmg": "$.lines.0.damages.0.id"}},
    {"name": "damage: waive", "method": "POST", "path": "/api/v1/rental/damages/{{dmg}}/waive", "body": {"reason": "goodwill"}},
    {"name": "damage: waive unknown", "method": "POST", "path": "/api/v1/rental/damages/00000000-0000-0000-0000-000000000000/waive", "body": {}},

    {"name": "service order", "method": "POST", "path": "/api/v1/rental/service-orders", "body": {"unitId": "{{u3}}", "type": "repair", "vendor": "Fixit", "cost": 12.5}, "capture": {"so": "$.id"}},
    {"name": "service order: unknown unit", "method": "POST", "path": "/api/v1/rental/service-orders", "body": {"unitId": "00000000-0000-0000-0000-000000000000", "type": "repair"}},
    {"name": "service orders", "method": "GET", "path": "/api/v1/rental/service-orders?unitId={{u3}}"},
    {"name": "service order: complete", "method": "POST", "path": "/api/v1/rental/service-orders/{{so}}/complete", "body": {"cost": 20}},
    {"name": "service order: complete again", "method": "POST", "path": "/api/v1/rental/service-orders/{{so}}/complete", "body": {}},
    {"name": "service order: cancel completed", "method": "POST", "path": "/api/v1/rental/service-orders/{{so}}/cancel"},

    {"name": "reports: utilization", "method": "GET", "path": "/api/v1/rental/reports/utilization?from=2030-05-01T00:00:00.000Z&to=2030-07-01T00:00:00.000Z"},
    {"name": "reports: revenue", "method": "GET", "path": "/api/v1/rental/reports/revenue?from=2030-05-01T00:00:00.000Z&to=2030-07-01T00:00:00.000Z"},
    {"name": "reports: fleet", "method": "GET", "path": "/api/v1/rental/reports/fleet?status=damaged"},

    {"name": "score (Nest 500, documented)", "method": "GET", "path": "/api/v1/rental/scores/{{cust}}"},
    {"name": "settle (Nest 500, documented)", "method": "POST", "path": "/api/v1/rental/returns/{{ret}}/settle", "headers": {"Idempotency-Key": "rental-parity-settle-1"}, "body": {}},
    {"name": "agreement after settle", "method": "GET", "path": "/api/v1/rental/agreements/{{ag}}"}
  ]
}
