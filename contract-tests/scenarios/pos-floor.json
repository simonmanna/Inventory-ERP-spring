{
  "name": "POS floor: zones, tables, stats, reservations, table reports, KDS board",
  "vars": { "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123" },
  "steps": [
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": { "organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}" }, "capture": { "token": "$.accessToken" } },
    { "name": "zones", "method": "GET", "path": "/api/v1/pos/tables/zones" },
    { "name": "zones deleted", "method": "GET", "path": "/api/v1/pos/tables/zones/deleted" },
    { "name": "zone: duplicate key", "method": "POST", "path": "/api/v1/pos/tables/zones", "body": { "name": "Indoor Clone", "key": "indoor" } },
    { "name": "tables", "method": "GET", "path": "/api/v1/pos/tables?active=true" },
    { "name": "table stats", "method": "GET", "path": "/api/v1/pos/tables/stats" },
    { "name": "table: unknown zone", "method": "POST", "path": "/api/v1/pos/tables", "body": { "name": "Parity", "number": 990001, "zone": "does_not_exist" } },
    { "name": "table: bad status", "method": "PUT", "path": "/api/v1/pos/tables/00000000-0000-4000-8000-000000000000/status", "body": { "status": "cleaning" } },
    { "name": "table: missing", "method": "GET", "path": "/api/v1/pos/tables/00000000-0000-4000-8000-000000000000" },
    { "name": "table: merge into itself", "method": "POST", "path": "/api/v1/pos/tables/00000000-0000-4000-8000-000000000000/merge/00000000-0000-4000-8000-000000000000" },
    { "name": "reservations", "method": "GET", "path": "/api/v1/pos/reservations?date=2026-01-01" },
    { "name": "reservation: bad range", "method": "POST", "path": "/api/v1/pos/reservations", "body": { "tableId": "00000000-0000-4000-8000-000000000000", "customerName": "A", "startAt": "2030-01-01T12:00:00Z", "endAt": "2030-01-01T10:00:00Z" } },
    { "name": "reservation: missing", "method": "GET", "path": "/api/v1/pos/reservations/00000000-0000-4000-8000-000000000000" },
    { "name": "reservations report", "method": "GET", "path": "/api/v1/pos/reports/reservations?fromDate=2020-01-01&toDate=2020-01-31" },
    { "name": "utilization: invalid date", "method": "GET", "path": "/api/v1/pos/reports/tables/utilization" },
    { "name": "utilization", "method": "GET", "path": "/api/v1/pos/reports/tables/utilization?date=2020-01-01" },
    { "name": "table revenue", "method": "GET", "path": "/api/v1/pos/reports/tables/revenue?fromDate=2020-01-01&toDate=2020-01-31" },
    { "name": "kds tickets", "method": "GET", "path": "/api/v1/pos/kds/tickets?status=new" },
    { "name": "kds transition: bad action", "method": "POST", "path": "/api/v1/pos/kds/tickets/00000000-0000-4000-8000-000000000000/transition", "body": { "action": "fly" } },
    { "name": "kds report live", "method": "GET", "path": "/api/v1/pos/kds/reports/live" }
  ]
}
