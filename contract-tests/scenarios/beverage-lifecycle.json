{
  "name": "Beverage count lifecycle on data (ENABLE_BEVERAGE=true, fresh seed): weigh, reason + approval gates, adjustment, reports",
  "vars": {"org": "DEMO", "email": "admin@demo.test", "password": "Admin@123"},
  "steps": [
    {"name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": {"organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}"}, "capture": {"token": "$.accessToken", "adminId": "$.user.id"}},
    {"name": "warehouse", "method": "GET", "path": "/api/v1/inventory/locations?type=warehouse", "capture": {"loc": "$.data.0.id"}},
    {"name": "supervisor role", "method": "POST", "path": "/api/v1/roles", "body": {"name": "Parity Bar Supervisor", "permissions": ["beverage:read", "beverage:approve"]}, "capture": {"roleId": "$.id"}},
    {"name": "supervisor user", "method": "POST", "path": "/api/v1/users", "body": {"email": "parity-bar-sup@demo.test", "password": "Super@123456", "firstName": "Bar", "lastName": "Supervisor", "roleIds": ["{{roleId}}"]}, "capture": {"supId": "$.id"}},
    {"name": "bottle product", "method": "POST", "path": "/api/v1/products", "body": {"code": "BEV-PARITY-1", "name": "Aaa Parity Whisky", "productType": "stockable", "costPrice": 0.05, "measurementMethod": "digital_weight", "containerVolumeMl": 700, "emptyBottleWeightG": 500, "fullBottleWeightG": 1200, "standardPourMl": 30, "varianceToleranceG": 5}, "capture": {"pid": "$.id"}},
    {"name": "bottle product: bad weights", "method": "POST", "path": "/api/v1/products", "body": {"code": "BEV-PARITY-BAD", "name": "Bad Bottle", "productType": "stockable", "measurementMethod": "digital_weight", "containerVolumeMl": 700, "emptyBottleWeightG": 1200, "fullBottleWeightG": 500}},
    {"name": "stock in 700 ml", "method": "POST", "path": "/api/v1/inventory/direct-stock/in", "headers": {"Idempotency-Key": "bev-parity-stock-in-1"}, "body": {"locationId": "{{loc}}", "responsibleById": "{{adminId}}", "approvedById": "{{adminId}}", "items": [{"productId": "{{pid}}", "quantity": 700, "unitCost": 0.05}]}},
    {"name": "start closing count", "method": "POST", "path": "/api/v1/beverage/counts/start", "body": {"locationId": "{{loc}}", "countType": "closing"}, "capture": {"countId": "$.id", "lineId": "$.lines.0.id"}},
    {"name": "submit: nothing weighed", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {}},
    {"name": "draft: weigh 1100 g", "method": "PATCH", "path": "/api/v1/beverage/counts/{{countId}}/draft", "body": {"notes": "parity", "lines": [{"lineId": "{{lineId}}", "readings": [{"measuredWeightG": 1100, "bottleNumber": "W-1"}]}]}},
    {"name": "draft: unknown reading field", "method": "PATCH", "path": "/api/v1/beverage/counts/{{countId}}/draft", "body": {"lines": [{"lineId": "{{lineId}}", "readings": [{"measuredWeightG": 1100, "nope": 1}]}]}},
    {"name": "draft: bad source", "method": "PATCH", "path": "/api/v1/beverage/counts/{{countId}}/draft", "body": {"lines": [{"lineId": "{{lineId}}", "readings": [{"measuredWeightG": 1100, "measurementSource": "PHONE"}]}]}},
    {"name": "submit: flagged without reason", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {}},
    {"name": "draft: add reason", "method": "PATCH", "path": "/api/v1/beverage/counts/{{countId}}/draft", "body": {"lines": [{"lineId": "{{lineId}}", "reason": "Spillage", "readings": [{"measuredWeightG": 1100, "bottleNumber": "W-1"}]}]}},
    {"name": "submit: no approver", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {}},
    {"name": "submit: self approval", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {"approverId": "{{adminId}}"}},
    {"name": "submit: PIN not set", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {"approverId": "{{supId}}", "managerPin": "1234"}},
    {"name": "submit: approved by supervisor", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {"approverEmail": "PARITY-BAR-SUP@demo.test"}},
    {"name": "count after submit", "method": "GET", "path": "/api/v1/beverage/counts/{{countId}}"},
    {"name": "submit again", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/submit", "body": {}},
    {"name": "cancel submitted", "method": "POST", "path": "/api/v1/beverage/counts/{{countId}}/cancel"},
    {"name": "counts list", "method": "GET", "path": "/api/v1/beverage/counts"},
    {"name": "variance", "method": "GET", "path": "/api/v1/beverage/reports/variance?locationId={{loc}}"},
    {"name": "yield", "method": "GET", "path": "/api/v1/beverage/reports/yield?from=2020-01-01"},
    {"name": "dashboard", "method": "GET", "path": "/api/v1/beverage/reports/dashboard?locationId={{loc}}"},
    {"name": "bartender", "method": "GET", "path": "/api/v1/beverage/reports/bartender?from=2020-01-01"},
    {"name": "opening count then cancel", "method": "POST", "path": "/api/v1/beverage/counts/start", "body": {"locationId": "{{loc}}", "countType": "opening"}, "capture": {"openId": "$.id"}},
    {"name": "cancel opening", "method": "POST", "path": "/api/v1/beverage/counts/{{openId}}/cancel"},
    {"name": "draft on cancelled", "method": "PATCH", "path": "/api/v1/beverage/counts/{{openId}}/draft", "body": {"lines": []}}
  ]
}
