{
  "name": "POS back office: sales reports on a fixed empty range, posting monitor, loyalty, credit, receipts, digital menu",
  "vars": { "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123", "range": "fromDate=2020-01-01&toDate=2020-01-07" },
  "steps": [
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": { "organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}" }, "capture": { "token": "$.accessToken" } },
    { "name": "filter options", "method": "GET", "path": "/api/v1/pos/reports/filter-options?{{range}}" },
    { "name": "sales summary day", "method": "GET", "path": "/api/v1/pos/reports/sales-summary?{{range}}&groupBy=day" },
    { "name": "sales summary bad groupBy", "method": "GET", "path": "/api/v1/pos/reports/sales-summary?{{range}}&groupBy=year" },
    { "name": "sales by hour", "method": "GET", "path": "/api/v1/pos/reports/sales-by-hour?{{range}}&hours=8,9" },
    { "name": "top items", "method": "GET", "path": "/api/v1/pos/reports/top-items?{{range}}&limit=5" },
    { "name": "sold items", "method": "GET", "path": "/api/v1/pos/reports/sold-items?{{range}}" },
    { "name": "sales report bad orderType", "method": "GET", "path": "/api/v1/pos/reports/sales-report?{{range}}&orderType=boat" },
    { "name": "sales report invalid range", "method": "GET", "path": "/api/v1/pos/reports/sales-report?fromDate=nope&toDate=2020-01-01" },
    { "name": "cashier report", "method": "GET", "path": "/api/v1/pos/reports/cashier-report?{{range}}" },
    { "name": "waiter report", "method": "GET", "path": "/api/v1/pos/reports/waiter-report?{{range}}" },
    { "name": "order report bad status", "method": "GET", "path": "/api/v1/pos/reports/order-report?{{range}}&status=bogus" },
    { "name": "order report", "method": "GET", "path": "/api/v1/pos/reports/order-report?{{range}}&includeCancelled=1" },
    { "name": "items by group", "method": "GET", "path": "/api/v1/pos/reports/items-by-group?{{range}}" },
    { "name": "item sales", "method": "GET", "path": "/api/v1/pos/reports/item-sales?{{range}}" },
    { "name": "items by server", "method": "GET", "path": "/api/v1/pos/reports/items-by-server?{{range}}&groupBy=shift" },
    { "name": "cashier shift summary", "method": "GET", "path": "/api/v1/pos/reports/cashier-shift-summary?{{range}}" },
    { "name": "z-report: unknown session", "method": "GET", "path": "/api/v1/pos/reports/z-report/00000000-0000-4000-8000-000000000000" },
    { "name": "posting monitor counts", "method": "GET", "path": "/api/v1/pos/posting-monitor/counts" },
    { "name": "posting monitor retry missing", "method": "POST", "path": "/api/v1/pos/posting-monitor/jobs/00000000-0000-4000-8000-000000000000/retry" },
    { "name": "posting monitor resolve no note", "method": "POST", "path": "/api/v1/pos/posting-monitor/exceptions/00000000-0000-4000-8000-000000000000/resolve", "body": { "status": "resolved", "note": " " } },
    { "name": "loyalty program", "method": "GET", "path": "/api/v1/pos/loyalty/program" },
    { "name": "store credit issue: under min", "method": "POST", "path": "/api/v1/pos/loyalty/credit/issue", "body": { "partnerId": "x", "amount": 0, "source": "gift_card", "fundingAccountId": "x" } },
    { "name": "open credit", "method": "GET", "path": "/api/v1/pos/credit/open?pageSize=5" },
    { "name": "statement: unknown customer", "method": "GET", "path": "/api/v1/pos/customers/00000000-0000-4000-8000-000000000000/statement" },
    { "name": "receipts page", "method": "GET", "path": "/api/v1/pos/receipts?pageSize=5&dateFrom=2020-01-01&dateTo=2020-01-07" },
    { "name": "closing statement: bad session id", "method": "POST", "path": "/api/v1/pos/receipts/print-closing-statement", "body": { "sessionId": "x", "text": "Z" } },
    { "name": "digital menu sessions", "method": "GET", "path": "/api/v1/pos/menu/sessions" },
    { "name": "online orders", "method": "GET", "path": "/api/v1/pos/menu/orders" },
    { "name": "online order status (whitelist rejects)", "method": "PATCH", "path": "/api/v1/pos/menu/orders/00000000-0000-4000-8000-000000000000/status", "body": { "status": "ready" } },
    { "name": "public catalog: expired token", "method": "GET", "path": "/api/v1/menu/public/catalog?token=nope" }
  ]
}
