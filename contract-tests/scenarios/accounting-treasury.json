{
  "name": "Accounting: money operations, bank accounts, transfers, payment methods, cash registers and sessions",
  "vars": { "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123", "k1": "6a1f0e1c-1d55-4f6e-9a65-0000000000d1", "k2": "6a1f0e1c-1d55-4f6e-9a65-0000000000d2" },
  "steps": [
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": { "organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}" }, "capture": { "token": "$.accessToken" } },
    { "name": "bank account lookup", "method": "GET", "path": "/api/v1/accounts?search=BANK-DEFAULT", "capture": { "bank": "$.data.0.id" } },
    { "name": "equity account lookup", "method": "GET", "path": "/api/v1/accounts?search=3100", "capture": { "equity": "$.data.0.id" } },
    { "name": "revenue account lookup", "method": "GET", "path": "/api/v1/accounts?search=4100", "capture": { "revenue": "$.data.0.id" } },
    { "name": "money accounts", "method": "GET", "path": "/api/v1/accounts/cash-flow" },
    { "name": "operation types", "method": "GET", "path": "/api/v1/accounts/cash-flow/operation-types" },
    { "name": "deposit: no key", "method": "POST", "path": "/api/v1/accounts/cash-flow/deposit", "body": { "accountId": "{{bank}}", "counterpartAccountId": "{{equity}}", "operationType": "owner_contribution", "amount": 1000, "description": "Parity capital" } },
    { "name": "deposit", "method": "POST", "path": "/api/v1/accounts/cash-flow/deposit", "headers": { "Idempotency-Key": "{{k1}}" }, "body": { "accountId": "{{bank}}", "counterpartAccountId": "{{equity}}", "operationType": "owner_contribution", "amount": 1000, "description": "Parity capital" } },
    { "name": "deposit: replay", "method": "POST", "path": "/api/v1/accounts/cash-flow/deposit", "headers": { "Idempotency-Key": "{{k1}}" }, "body": { "accountId": "{{bank}}", "counterpartAccountId": "{{equity}}", "operationType": "owner_contribution", "amount": 1000, "description": "Parity capital" } },
    { "name": "withdraw: wrong counterpart kind", "method": "POST", "path": "/api/v1/accounts/cash-flow/withdraw", "headers": { "Idempotency-Key": "{{k2}}" }, "body": { "accountId": "{{bank}}", "counterpartAccountId": "{{revenue}}", "operationType": "owner_drawing", "amount": 10, "description": "x" } },
    { "name": "money overview", "method": "GET", "path": "/api/v1/accounts/cash-flow/overview" },
    { "name": "money activity", "method": "GET", "path": "/api/v1/accounts/cash-flow/activity?categories=deposits" },
    { "name": "money activity: invalid", "method": "GET", "path": "/api/v1/accounts/cash-flow/activity?direction=sideways&bogus=1" },
    { "name": "money report", "method": "GET", "path": "/api/v1/accounts/cash-flow/report?groupBy=month" },
    { "name": "bank transactions", "method": "GET", "path": "/api/v1/accounts/cash-flow/{{bank}}/transactions" },
    { "name": "bank accounts", "method": "GET", "path": "/api/v1/bank-accounts" },
    { "name": "bank reconciliation status", "method": "GET", "path": "/api/v1/bank-reconciliation/status?bankAccountId={{bank}}" },
    { "name": "payment methods", "method": "GET", "path": "/api/v1/accounts/pos-payment-methods" },
    { "name": "payment method: wrong account", "method": "POST", "path": "/api/v1/accounts/pos-payment-methods", "body": { "code": "parity-mm", "label": "MM", "kind": "mobile_money", "accountId": "{{bank}}" } },
    { "name": "payment method: invalid kind", "method": "POST", "path": "/api/v1/accounts/pos-payment-methods", "body": { "code": "parity-x", "label": "X", "kind": "crypto" } },
    { "name": "cash registers", "method": "GET", "path": "/api/v1/cash-registers" },
    { "name": "cash register: not found", "method": "GET", "path": "/api/v1/cash-registers/00000000-0000-0000-0000-000000000000" },
    { "name": "open session", "method": "GET", "path": "/api/v1/cash-sessions/open" },
    { "name": "session history", "method": "GET", "path": "/api/v1/cash-sessions/history" },
    { "name": "daily report", "method": "GET", "path": "/api/v1/cash-sessions/report/daily?date=2026-01-15" },
    { "name": "tender settlements", "method": "GET", "path": "/api/v1/cash-sessions/tender-settlements" },
    { "name": "tender settlement sources", "method": "GET", "path": "/api/v1/cash-sessions/tender-settlements/sources" },
    { "name": "session: not found", "method": "GET", "path": "/api/v1/cash-sessions/00000000-0000-0000-0000-000000000000" },
    { "name": "reconcile: not found", "method": "PATCH", "path": "/api/v1/cash-sessions/00000000-0000-0000-0000-000000000000/reconcile", "body": {} }
  ]
}
