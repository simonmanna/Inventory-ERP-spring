{
  "name": "POS terminal: settings, lookup, payment methods, kitchen stations, menu, modifiers, PIN, validation errors",
  "vars": { "org": "DEMO", "email": "admin@demo.test", "password": "Admin@123" },
  "steps": [
    { "name": "login", "method": "POST", "path": "/api/v1/auth/login", "body": { "organizationCode": "{{org}}", "email": "{{email}}", "password": "{{password}}" }, "capture": { "token": "$.accessToken" } },
    { "name": "settings", "method": "GET", "path": "/api/v1/pos/settings" },
    { "name": "settings: bad posMode", "method": "PATCH", "path": "/api/v1/pos/settings", "body": { "posMode": "bogus" } },
    { "name": "lookup: unknown sku", "method": "GET", "path": "/api/v1/pos/lookup?sku=NO-SUCH-SKU" },
    { "name": "payment methods", "method": "GET", "path": "/api/v1/pos/payment-methods" },
    { "name": "payment accounts", "method": "GET", "path": "/api/v1/pos/payment-accounts" },
    { "name": "kitchen stations", "method": "GET", "path": "/api/v1/pos/kitchen-stations" },
    { "name": "kitchen station: bad code", "method": "POST", "path": "/api/v1/pos/kitchen-stations", "body": { "name": "G", "code": "a b" } },
    { "name": "menu categories", "method": "GET", "path": "/api/v1/pos/menu/categories" },
    { "name": "menu items page", "method": "GET", "path": "/api/v1/pos/menu/items?page=1&pageSize=5" },
    { "name": "menu items: bad category", "method": "GET", "path": "/api/v1/pos/menu/items?categoryId=x" },
    { "name": "menu items available", "method": "GET", "path": "/api/v1/pos/menu/items/available" },
    { "name": "menu item: no recipe", "method": "POST", "path": "/api/v1/pos/menu/items", "body": { "name": "Parity X" } },
    { "name": "menu item: unknown station", "method": "POST", "path": "/api/v1/pos/menu/items", "body": { "name": "Parity Y", "isInventoryTracked": false, "stationCode": "nope" } },
    { "name": "modifier groups", "method": "GET", "path": "/api/v1/pos/modifiers/groups?page=1&pageSize=5" },
    { "name": "combos", "method": "GET", "path": "/api/v1/pos/modifiers/combos" },
    { "name": "accompaniment groups", "method": "GET", "path": "/api/v1/pos/menu/accompaniments/groups" },
    { "name": "staff on terminal", "method": "GET", "path": "/api/v1/pos/auth/staff" },
    { "name": "pin login: wrong pin", "method": "POST", "path": "/api/v1/pos/auth/pin-login", "body": { "userId": "00000000-0000-4000-8000-000000000000", "pin": "0000" } },
    { "name": "override verify-pin: wrong", "method": "POST", "path": "/api/v1/pos/override/verify-pin", "body": { "pin": "0000" } },
    { "name": "checkout: no key", "method": "POST", "path": "/api/v1/pos/checkout", "body": { "lines": [{ "description": "X", "quantity": 1, "unitPrice": 1 }] } },
    { "name": "checkout: empty cart", "method": "POST", "path": "/api/v1/pos/checkout", "headers": { "Idempotency-Key": "6a1f0e1c-1d55-4f6e-9a65-0000000005a1" }, "body": { "lines": [] } },
    { "name": "checkout: negative tender", "method": "POST", "path": "/api/v1/pos/checkout", "headers": { "Idempotency-Key": "6a1f0e1c-1d55-4f6e-9a65-0000000005a2" }, "body": { "lines": [{ "description": "X", "quantity": 1, "unitPrice": 1 }], "tenders": [{ "method": "card", "amount": -5 }] } },
    { "name": "quote: empty", "method": "POST", "path": "/api/v1/pos/orders/quote", "body": { "lines": [] } },
    { "name": "orders open", "method": "GET", "path": "/api/v1/pos/orders/open" },
    { "name": "holds", "method": "GET", "path": "/api/v1/pos/holds?status=open" },
    { "name": "hold: no lines", "method": "POST", "path": "/api/v1/pos/holds", "body": { "name": "H", "lines": [] } }
  ]
}
